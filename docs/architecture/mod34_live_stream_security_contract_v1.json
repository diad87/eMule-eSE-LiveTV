    "stream_identity": "a_public_key_is_accepted_only_after_the_adapter_proves_sha1_pubkey_prefix_matches_stream_key",
    "pinning": "first_valid_key_wins_until_clear_same_key_is_idempotent_key_switch_fails_closed",
    "pin_capacity": 256,
    "replay": "only_a_cryptographically_verified_sequence_may_advance_the_replay_window",
