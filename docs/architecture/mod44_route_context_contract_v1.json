      "pathModule"
    ]
  },
  "limits": {
    "composition_root_physical_lines": 300,
    "route_module_physical_lines": 500
  },
  "stop_conditions": [
    "a route reads an undeclared _ctx property",
    "a route accepts null, missing, or inherited required dependencies",
    "validation retains the caller context object",
