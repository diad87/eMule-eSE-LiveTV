<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <_EseQuicRoot Condition="'$(EseQuicReleaseRoot)'!=''">$(EseQuicReleaseRoot)</_EseQuicRoot>
    <_EseQuicRoot Condition="'$(EseQuicReleaseRoot)'==''">$(EseQuicDependencyRoot)</_EseQuicRoot>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(_EseQuicRoot)'!=''">
    <Link>
      <AdditionalDependencies>$(_EseQuicRoot)\gnutls-$(Platform).lib;$(_EseQuicRoot)\build-$(Platform)\lib\Release\ngtcp2.lib;$(_EseQuicRoot)\build-$(Platform)\crypto\gnutls\Release\ngtcp2_crypto_gnutls.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(EseQuicReleaseRoot)'!=''">
    <ClCompile>
      <PreprocessorDefinitions>ESE_QUIC_SIGNED_RELEASE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ResourceCompile>
      <PreprocessorDefinitions>ESE_QUIC_SIGNED_RELEASE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(IntDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(EseQuicReleaseRoot)'!='' And '$(Platform)'=='Win32'">
    <Link>
      <AdditionalOptions>/Brepro /PDBALTPATH:%_PDB% %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup Condition="'$(_EseQuicRoot)'!=''">
    <ClCompile Include="EseNativeQuicRuntime.cpp;EseQuicHeaderProbe.cpp;EseQuicSocketOwner.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <AdditionalIncludeDirectories>$(_EseQuicRoot)\ngtcp2-1.25.0\lib\includes;$(_EseQuicRoot)\build-$(Platform)\lib\includes;$(_EseQuicRoot)\ngtcp2-1.25.0\crypto\includes;$(_EseQuicRoot)\include-$(Platform);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemGroup>
  <Target Name="VerifyEseNativeQuicLabInputs" BeforeTargets="PrepareForBuild" Condition="'$(EseQuicDependencyRoot)'!=''">
    <Error Condition="'$(EseQuicLabOnly)'!='true'" Text="Native QUIC requires explicit /p:EseQuicLabOnly=true; dependency provenance is not release-approved." />
    <Error Condition="'$(Configuration)'!='Release'" Text="Pinned QUIC laboratory inputs support Release only." />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\verify_quic_host_dependencies.ps1&quot; -Root &quot;$(EseQuicDependencyRoot)&quot; -Architecture $(Platform)" />
  </Target>
  <Target Name="VerifyEseNativeQuicReleaseInputs" BeforeTargets="PrepareForBuild" Condition="'$(EseQuicReleaseRoot)'!=''">
    <Error Condition="'$(EseQuicDependencyRoot)'!='' Or '$(EseQuicLabOnly)'!=''" Text="Select either signed release QUIC inputs or laboratory QUIC inputs." />
    <Error Condition="'$(Configuration)'!='Release' Or ('$(Platform)'!='x64' And '$(Platform)'!='Win32')" Text="Signed QUIC release inputs support Release|x64 and Release|Win32." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(EseQuicReleaseManifestSha256)', '^[A-Fa-f0-9]{64}$'))" Text="Signed QUIC needs the verified manifest SHA-256 in EseQuicReleaseManifestSha256." />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\tools\verify_quic_release_dependencies.ps1&quot; -Root &quot;$(EseQuicReleaseRoot)&quot; -Architecture $(Platform) -ExpectedManifestSha256 $(EseQuicReleaseManifestSha256)" />
    <MakeDir Directories="$(IntDir)" />
    <WriteLinesToFile File="$(IntDir)EseQuicReleaseManifest.h"
      Lines="#define ESE_QUIC_RELEASE_MANIFEST_SHA256 &quot;$(EseQuicReleaseManifestSha256)&quot;"
      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
