{
  "name": "eSE",
  "version": "9.1.0-beta.1",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "test": "npm run test:live",
    "test:live": "node --test test/live_tv_regression.test.js",
    "start": "node server.js",
    "prebuild": "node tools/bundle_client.js",
    "build": "pkg . --targets node22-win-x64 --output ese-server.exe --compress GZip"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "hls.js": "^1.6.16"
  },
  "pkg": {
    "scripts": [
      "runtime_dir.js",
      "eSE-live/*.js",
      "eSE-live/lan_discovery.js",
      "pages/*.js",
      "routes/*.js"
    ],
    "assets": [
      "emule_mascot.svg",
      "favicon.ico",
      "eSE_Remote.html",
      "eSE-live/vendor/hls.min.js",
      "eSE-live/vendor/hls.LICENSE",
      "eSE-live/thumbs/**/*",
      "eSE-live/live/.gitkeep",
      "_player_bundle.js"
    ],
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "dist"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.21.0"
  }
}
