<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Mirror each language DLL into the selected platform's runtime directory.
    The project post-build copy also maintains the historical language path.
  -->
  <ItemDefinitionGroup Condition="'$(Platform)'=='Win32'">
    <Link>
      <AdditionalOptions>/Brepro /PDBALTPATH:%_PDB% %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="CopyLanguageNextToEmule" AfterTargets="Build" Condition="'$(Platform)'=='x64' Or '$(Platform)'=='Win32'">
    <PropertyGroup>
      <EmuleRuntimeLangDir>$(MSBuildThisFileDirectory)..\$(Platform)\Release\lang\</EmuleRuntimeLangDir>
    </PropertyGroup>
    <MakeDir Directories="$(EmuleRuntimeLangDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(EmuleRuntimeLangDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
