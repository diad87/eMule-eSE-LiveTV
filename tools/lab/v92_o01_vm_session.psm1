function Assert-O01SessionState {
    param([Parameter(Mandatory=$true)]$State)
    $expected=@('schema','vm_started','guest_session','firewall_names','differencing_vhd','differencing_created','original_vhd','original_switch','plan_path','plan_hash','state_path','t8_applied')
    $actual=@($State.PSObject.Properties.Name|Sort-Object)
    if(($actual-join ',') -cne (@($expected|Sort-Object)-join ',') -or [string]$State.schema -cne 'ese.v92.o01-vm-session-state/v1' -or
       $State.firewall_names -isnot [object[]] -or @($State.firewall_names).Count -ne 3 -or @($State.firewall_names|Select-Object -Unique).Count -ne 3 -or
       @($State.firewall_names|Where-Object{$_ -isnot [string] -or $_ -cnotmatch '^ese-v92-o01-[0-9a-f]{12}-(udp5351|udp1900|tcp54321)$'}).Count -ne 0) { throw 'O01_SESSION_STATE_INVALID' }
}

function Invoke-O01SessionRollback {
    [CmdletBinding()]
    param([Parameter(Mandatory=$true)]$State,[Parameter(Mandatory=$true)]$Operations)
    Assert-O01SessionState $State
    $operationNames=@('CloseGuestSession','StopGuest','RemoveFirewallRule','VerifyFirewallAbsent','RestoreBaseDisk','RemoveDifferencingDisk','RestoreNic','TeardownT8','VerifyBaseline')
    foreach($name in $operationNames){if($null-eq$Operations.PSObject.Properties[$name] -or $Operations.$name -isnot [scriptblock]){throw 'O01_SESSION_OPERATIONS_INVALID'}}
    $failures=New-Object Collections.Generic.List[Exception]
    function Invoke-Stage([string]$Name,[scriptblock]$Action){try{&$Action}catch{$failures.Add([InvalidOperationException]::new("O01_SESSION_ROLLBACK_${Name}",$_.Exception))}}
    Invoke-Stage 'GUEST_SESSION' { if($null-ne$State.guest_session){&$Operations.CloseGuestSession $State.guest_session;$State.guest_session=$null} }
    Invoke-Stage 'GUEST_POWER' { if([bool]$State.vm_started){&$Operations.StopGuest;$State.vm_started=$false} }
    foreach($name in @($State.firewall_names)){Invoke-Stage 'FIREWALL_REMOVE' { &$Operations.RemoveFirewallRule $name }.GetNewClosure()}
    foreach($name in @($State.firewall_names)){Invoke-Stage 'FIREWALL_VERIFY' { &$Operations.VerifyFirewallAbsent $name }.GetNewClosure()}
    Invoke-Stage 'BASE_DISK' { &$Operations.RestoreBaseDisk ([string]$State.differencing_vhd) ([string]$State.original_vhd) }
    Invoke-Stage 'DIFFERENCING_DISK' { if([bool]$State.differencing_created){&$Operations.RemoveDifferencingDisk ([string]$State.differencing_vhd) ([string]$State.original_vhd);$State.differencing_created=$false} }
    Invoke-Stage 'NIC' { &$Operations.RestoreNic ([string]$State.original_switch) }
    Invoke-Stage 'T8' { if([bool]$State.t8_applied){&$Operations.TeardownT8 ([string]$State.plan_path) ([string]$State.plan_hash) ([string]$State.state_path);$State.t8_applied=$false} }
    Invoke-Stage 'BASELINE' { &$Operations.VerifyBaseline }
    if($failures.Count -gt 0){throw [AggregateException]::new('O01_SESSION_ROLLBACK_FAILED',$failures)}
}

function Start-O01VmSession {
    [CmdletBinding()]
    param([Parameter(Mandatory=$true)]$State,[Parameter(Mandatory=$true)]$Operations)
    Assert-O01SessionState $State
    $required=@('CreateDifferencingDisk','AttachDifferencingDisk','ApplyT8','ConnectT8Nic','CreateFirewallRule','StartGuest','ConfigureGuest','OpenGuestSession','RollbackOperations')
    foreach($name in $required){if($null-eq$Operations.PSObject.Properties[$name] -or ($name-ne'RollbackOperations' -and $Operations.$name-isnot[scriptblock])){throw 'O01_SESSION_START_OPERATIONS_INVALID'}};function Invoke-StartStage([string]$Name,[scriptblock]$Action){try{return &$Action}catch{throw [InvalidOperationException]::new("O01_SESSION_START_${Name}",$_.Exception)}}
    try {
        Invoke-StartStage 'CREATE_DIFFERENCING_DISK' {&$Operations.CreateDifferencingDisk ([string]$State.differencing_vhd) ([string]$State.original_vhd)};$State.differencing_created=$true
        Invoke-StartStage 'ATTACH_DIFFERENCING_DISK' {&$Operations.AttachDifferencingDisk ([string]$State.differencing_vhd)}
        $binding=Invoke-StartStage 'APPLY_T8' {&$Operations.ApplyT8 ([string]$State.plan_path) ([string]$State.state_path)};if($null-eq$binding-or$binding.PSObject.Properties.Name-notcontains'plan_hash'){throw 'O01_SESSION_T8_BINDING_INVALID'};$State.plan_hash=[string]$binding.plan_hash;$State.t8_applied=$true
        Invoke-StartStage 'CONNECT_T8_NIC' {&$Operations.ConnectT8Nic $binding}
        foreach($name in @($State.firewall_names)){Invoke-StartStage 'CREATE_FIREWALL_RULE' {&$Operations.CreateFirewallRule $name $binding}.GetNewClosure()}
        Invoke-StartStage 'START_GUEST' {&$Operations.StartGuest};$State.vm_started=$true
        Invoke-StartStage 'CONFIGURE_GUEST' {&$Operations.ConfigureGuest $binding}
        $State.guest_session=Invoke-StartStage 'OPEN_GUEST_SESSION' {&$Operations.OpenGuestSession};if($null-eq$State.guest_session){throw 'O01_SESSION_GUEST_SESSION_INVALID'}
        return $binding
    } catch {
        $primary=$_.Exception
        try{Invoke-O01SessionRollback $State $Operations.RollbackOperations}catch{throw [AggregateException]::new('O01_SESSION_START_AND_ROLLBACK_FAILED',@($primary,$_.Exception))}
        throw $primary
    }
}
