<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Import immediately before Cpp.targets. Keep the pinned submodule intact.
       Modern Windows SDK headers require default packing; libutp wire structs
       retain their explicit local pragma pack directives. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <StructMemberAlignment>Default</StructMemberAlignment>
      <!-- utp.h exposes a plain C ABI; eMule callers use cdecl on Win32. -->
      <CallingConvention>Cdecl</CallingConvention>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
